<?xml version="1.0" encoding="utf-8" ?>
<!-- The menu down the left, as on the Fire TV (src/routes/tv/+layout.svelte): who's watching,
     Search, Home, Movies, TV Shows, Anime, My Library, Live TV, YouTube, Settings. Narrow with just its
     icons; highlighted, it opens wider with their names over a darkened screen. -->
<component name="NavMenu" extends="Group">
    <interface>
        <field id="current" type="string" onChange="paint" />
        <field id="open" type="boolean" onChange="paint" />
        <field id="who" type="string" onChange="build" />
        <field id="whoColor" type="string" onChange="build" />
        <field id="chosen" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/NavMenu.brs" />
    <children>
        <!-- Under the backing, over the whole screen: the backing fades out into it with no edge. -->
        <Rectangle id="dim" width="1920" height="1080" color="0x00000073" visible="false" />
        <Poster id="backing" width="160" height="1080" uri="pkg:/images/nav_closed.png" />
        <!-- The logo: the pink dot while the menu is narrow, the whole name once it opens (as the Fire TV). -->
        <Poster id="logoDot" translation="[40, 52]" width="28" height="28" uri="pkg:/images/logo_dot.png" />
        <Poster id="logoWord" translation="[30, 46]" width="140" height="40" uri="pkg:/images/logo_word.png" visible="false" />
        <Group id="items" translation="[30, 120]" />
    </children>
</component>
