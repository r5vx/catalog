<?xml version="1.0" encoding="utf-8" ?>
<!-- Live TV, as on the Fire TV (src/routes/tv/live): On now, Saved, each sport and Channels
     along the top, then the games three across (/api/roku/live). A game opens a box with the
     channels showing it and Save; a channel plays straight away. -->
<component name="LiveScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" onChange="start" />
        <field id="action" type="assocarray" />
        <field id="closing" type="boolean" />
        <field id="resumed" type="boolean" alwaysNotify="true" onChange="start" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/LiveScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/common.brs" />
    <children>
        <!-- Grids wrap round by default (down on the last row went back to the first, forever, and never
             reached the games); floatingFocus stops at the edge, so down goes on to the games. -->
        <MarkupGrid id="chips" translation="[20, 56]" itemComponentName="TileItem" numColumns="7" numRows="2" itemSize="[220, 60]" itemSpacing="[16, 16]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        <Label id="heading" translation="[20, 220]" font="font:MediumBoldSystemFont" color="0xE7EDE9FF" />
        <Label id="status" translation="[0, 510]" width="1612" horizAlign="center" font="font:MediumSystemFont" color="0x75837BFF" text="Loading the schedule…" />
        <MarkupGrid id="grid" translation="[20, 262]" itemComponentName="TileItem" numColumns="3" numRows="3" itemSize="[568, 228]" itemSpacing="[2, 2]" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
    </children>
</component>
