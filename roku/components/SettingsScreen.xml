<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings on the Roku: who's watching, the player's habits on a TV (captions, auto-skip and
     autoplay start on, as on the Fire TV), and which computer Catalog is on. -->
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" onChange="show" />
        <field id="action" type="assocarray" />
        <field id="closing" type="boolean" />
        <field id="resumed" type="boolean" alwaysNotify="true" onChange="show" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/common.brs" />
    <children>
        <Label text="Settings" translation="[20, 64]" font="font:LargeBoldSystemFont" color="0xE7EDE9FF" />
        <LabelList id="options" translation="[20, 180]" itemSize="[900, 76]" itemSpacing="[0, 12]" numRows="8" color="0xE7EDE9FF" focusedColor="0x111614FF" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
        <Label id="about" translation="[20, 900]" width="1500" font="font:SmallSystemFont" color="0x75837BFF" />
    </children>
</component>
