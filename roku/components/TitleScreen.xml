<?xml version="1.0" encoding="utf-8" ?>
<!-- One film or show, as on the Fire TV (src/routes/tv/title): its picture behind, name, facts,
     how far through, what it's about; then Play (or Resume), From the start, My List; a show's
     seasons and episodes with their pictures; More like this. Going down to the episodes, they
     slide up under the name. -->
<component name="TitleScreen" extends="Group">
    <interface>
        <field id="params" type="assocarray" onChange="start" />
        <field id="action" type="assocarray" />
        <field id="closing" type="boolean" />
        <field id="resumed" type="boolean" alwaysNotify="true" onChange="start" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/TitleScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/common.brs" />
    <children>
        <Poster id="art" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.6" />
        <Poster uri="pkg:/images/title_shade.png" width="1920" height="1080" />
        <Label id="name" translation="[96, 90]" width="1100" wrap="true" maxLines="2" font="font:LargeBoldSystemFont" color="0xE7EDE9FF" />
        <Group id="info">
            <Label id="facts" translation="[96, 0]" width="1100" font="font:SmallSystemFont" color="0xA3B0A8FF" />
            <Rectangle id="barBack" width="300" height="8" color="0xFFFFFF33" visible="false" />
            <Rectangle id="bar" height="8" color="0xD97A83FF" visible="false" />
            <Label id="left" font="font:SmallSystemFont" color="0xA3B0A8FF" visible="false" />
            <Label id="about" translation="[96, 0]" width="1050" wrap="true" maxLines="4" lineSpacing="4" font="font:SmallSystemFont" color="0xE7EDE9FF" />
        </Group>
        <Label id="status" translation="[96, 600]" width="1600" font="font:SmallSystemFont" color="0x75837BFF" text="Loading…" />
        <RowList
            id="rows"
            translation="[96, 560]"
            itemComponentName="TileItem"
            numRows="4"
            itemSize="[1760, 400]"
            rowItemSize="[[380, 80]]"
            rowItemSpacing="[[22, 0]]"
            rowLabelOffset="[[0, 12]]"
            rowLabelColor="0xA3B0A8FF"
            rowLabelFont="font:SmallBoldSystemFont"
            drawFocusFeedback="false"
            rowFocusAnimationStyle="floatingFocus"
            vertFocusAnimationStyle="floatingFocus"
            visible="false" />
        <Timer id="warm" duration="1.2" />
    </children>
</component>
