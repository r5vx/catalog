# Free key from https://www.themoviedb.org/settings/api  (v3 auth "API Key")
# Copy this file to `.env` and paste your key in. Anime search works without it.
# You can also just paste it into Settings, which is easier.
TMDB_API_KEY=

# Only needed to publish a release with `npm run release`.
# Make one at https://github.com/settings/tokens with permission to write
# repository contents. Without it the installer is still built — it just
# isn't uploaded.
GH_TOKEN=
