<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Catalog for iPhone: what iOS needs to know about the app. ios/build.sh copies this into the app.
	CFBundleShortVersionString is the version people see; CFBundleVersion must go up with every build
	that's handed out, or the phone won't take it as an update.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Catalog</string>
	<key>CFBundleDisplayName</key>
	<string>Catalog</string>
	<key>CFBundleExecutable</key>
	<string>Catalog</string>
	<key>CFBundleIdentifier</key>
	<string>app.catalog.phone</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>DTPlatformName</key>
	<string>iphoneos</string>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- The icon: plain picture files beside this one (made from static/icon-phone.png). -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
			</array>
		</dict>
	</dict>

	<!-- An empty opening screen in the phone's own light or dark color (without this key iOS draws
	     the app small, with black bars). -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>Catalog.SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Catalog at home is a plain http:// address on the Wi-Fi. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Catalog opens your library from the computer it runs on, over your Wi-Fi.</string>
	<key>NSCameraUsageDescription</key>
	<string>To read the code on the computer's Settings, Phones page.</string>

	<!-- Lets sound from a video carry on with the screen off. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
